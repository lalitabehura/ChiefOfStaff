# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------
ENVIRONMENT=production

# python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Public URL of the app (HTTPS) and hostnames it answers to
FRONTEND_URL=https://cos.example.com
ALLOWED_HOSTS=["cos.example.com","localhost","127.0.0.1"]
CORS_ORIGINS=["https://cos.example.com"]

# Optional: Anthropic API key enables AI triage, drafting and free-form chat.
# Without it, the app uses built-in deterministic rules.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_REQUEST_LIMIT=200

# Optional: Google OAuth (Gmail + Calendar). Redirect URI must match the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://cos.example.com/api/v1/integrations/google/callback

# Outbound mail for password resets
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
